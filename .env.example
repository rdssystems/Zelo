# Copie para .env e preencha. NUNCA commitar o .env real.
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://zelo:zelo@db:5432/zelo
REDIS_URL=redis://redis:6379/0

ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox

# Login com Google (django-allauth) — criar em console.cloud.google.com,
# ver 02-ARQUITETURA.md §5 pro passo a passo
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

DEFAULT_FROM_EMAIL=nao-responda@zelo.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
